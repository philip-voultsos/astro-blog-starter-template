import { profile } from '../content/profile';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isAbout = pathname.startsWith('/about');
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header site-width">
  <a href="/" class="brand" aria-label={`${profile.name} — home`}>
    <span class="brand-name">{profile.name}</span>
    <span class="brand-field">Politics <i aria-hidden="true">/</i> Economics <i aria-hidden="true">/</i> History</span>
  </a>

  <nav class="primary-nav" aria-label="Primary navigation">
    <a href="/" class={isHome ? 'nav-link is-active' : 'nav-link'} aria-current={isHome ? 'page' : undefined}>Overview</a>
    <a href="/about" class={isAbout ? 'nav-link is-active' : 'nav-link'} aria-current={isAbout ? 'page' : undefined}>Background</a>
    <a href="/cv.pdf" class="nav-link nav-cv magnetic" target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<script>
  import '../scripts/motion';
</script>
