---
---

<header class="header-root">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <span class="brand-name">Philip Voultsos</span>
    </a>
    <nav class="nav-cluster">
      <a href="/" class="nav-item">Home</a>
      <a href="/about" class="nav-item">About</a>
      <a href="/cv" class="nav-item">CV</a>
      <a href="/blog" class="nav-item">Writing</a>
      <a href="/contact" class="nav-item contact-pill">Contact</a>
    </nav>
  </div>
</header>

<style>
  .header-root {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 250, 250, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--glass-border);
  }
  .header-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  .brand-link {
    text-decoration: none;
  }
  .brand-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: -0.02em;
  }
  .nav-cluster {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-item {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav-item:hover {
    color: var(--primary);
  }
  .contact-pill {
    background: rgba(0, 73, 83, 0.06);
    color: var(--primary);
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    font-weight: 600;
    border: 1px solid rgba(0, 73, 83, 0.1);
  }
  .contact-pill:hover {
    background: rgba(0, 73, 83, 0.12);
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
    }
    .nav-cluster {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
