---
// Header.astro
const pathname = new URL(Astro.request.url).pathname;
const isHome = pathname === '/';
---

<header class="site-header">
  <nav class="nav-container">
    <a href="/" class="nav-logo">
      <span class="logo-symbol">PV</span>
      <span class="logo-text">Philip Voultsos</span>
    </a>

    <div class="nav-links">
      <a href="/" class={isHome ? 'active' : ''}>Home</a>
      <a href="/about" class={pathname.startsWith('/about') ? 'active' : ''}>About</a>
      <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="external-cv">
        <span>CV</span>
        <svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    margin-bottom: 3rem;
    padding-top: 1.5rem;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--glass-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 9999px;
    padding: 0.75rem 1.75rem;
    box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.4);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-heading);
    font-weight: 700;
  }

  .logo-symbol {
    font-family: 'Cinzel', serif;
    background: linear-gradient(135deg, var(--primary-bright), var(--primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 1.1rem;
    font-weight: 900;
  }

  .logo-text {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-links a:hover, .nav-links a.active {
    color: var(--primary-bright);
  }

  .external-cv {
    opacity: 0.9;
  }

  .external-icon {
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .external-cv:hover .external-icon {
    transform: translate(1px, -1px);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .nav-container {
      padding: 0.6rem 1.25rem;
      border-radius: 20px;
    }
    .logo-text {
      display: none;
    }
    .nav-links {
      gap: 1.25rem;
    }
  }
</style>
