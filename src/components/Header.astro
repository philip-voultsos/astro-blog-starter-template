---
---

<header class="header-root">
  <div class="header-inner">
    <a href="/" class="brand-link">
      <span class="brand-name">Philip Voultsos</span>
    </a>
    <nav class="nav-cluster">
      <a href="/" class="nav-item">Home</a>
      <a href="/about" class="nav-item">About</a>
      <a href="/cv" class="nav-item">CV</a>
      <a href="/blog" class="nav-item">Writing</a>
      <a href="/contact" class="nav-item contact-pill">Contact</a>
    </nav>
  </div>
</header>

<style>
  .header-root {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(9, 13, 14, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--glass-border);
  }
  
  .header-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 1.15rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  
  .brand-link {
    text-decoration: none;
  }
  
  .brand-name {
    font-family: 'Cinzel', Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
  
  .brand-link:hover .brand-name {
    color: var(--primary-bright);
  }
  
  .nav-cluster {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  
  .nav-item {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  
  .nav-item:hover {
    color: var(--text-heading);
  }
  
  .contact-pill {
    background: rgba(73, 125, 123, 0.12);
    color: var(--primary-bright);
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    font-weight: 700;
    border: 1px solid rgba(73, 125, 123, 0.3);
    /* Hooked into the global spring physics */
    transition: transform 0.3s var(--spring-bounce), background 0.2s ease, color 0.2s ease, box-shadow 0.3s ease;
    will-change: transform;
  }
  
  .contact-pill:hover {
    background: rgba(73, 125, 123, 0.25);
    color: var(--text-heading);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px -2px rgba(73, 125, 123, 0.25);
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column;
      gap: 0.85rem;
      padding: 1rem 1.25rem;
    }
    .nav-cluster {
      gap: 1.25rem;
      font-size: 0.9rem;
    }
  }
</style>
