---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-brand" href="/" aria-label="Philip Voultsos — home">Philip Voultsos<span aria-hidden="true">.</span></a>
      <p class="footer-note">Interested in ideas, institutions, and the people shaping them.</p>
      <nav class="footer-links" aria-label="Contact links">
        <a href="mailto:philip@voultsos.com">Email <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/voultsosp/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} Philip Voultsos</p>
      <p>Athens, Greece <span class="footer-separator" aria-hidden="true">/</span> Personal academic profile</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4.5rem, 8vw, 7.5rem);
    padding: 2.8rem 1.75rem 1.3rem;
    border-top: 1px solid var(--line-strong);
  }
  .footer-inner { width: min(var(--site-width), 100%); margin: 0 auto; }
  .footer-top {
    display: grid;
    grid-template-columns: auto minmax(180px, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: 2.5rem;
  }
  .footer-brand {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .footer-brand span { color: var(--accent); }
  .footer-note { max-width: 23rem; color: var(--muted); font-size: 0.82rem; line-height: 1.85; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1.3rem; }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .footer-links a span { color: var(--accent); transition: transform 300ms var(--ease-soft); }
  .footer-links a:hover { color: var(--accent); }
  .footer-links a:hover span { transform: translate(2px, -2px); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .footer-bottom p { color: var(--muted-light); font-size: 0.65rem; line-height: 1.7; }
  .footer-separator { padding: 0 0.45rem; color: var(--accent); }
  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; align-items: start; }
    .footer-brand { grid-column: 1; }
    .footer-note { grid-column: 1; }
    .footer-links { grid-column: 2; grid-row: 1 / span 2; justify-content: flex-end; padding-top: 0.25rem; }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 2.5rem 0.8rem 1.2rem; }
    .footer-top { grid-template-columns: 1fr; gap: 0.9rem; padding-bottom: 2rem; }
    .footer-brand, .footer-note, .footer-links { grid-column: auto; grid-row: auto; justify-content: flex-start; }
    .footer-links { gap: 1.2rem; padding-top: 0.25rem; }
    .footer-bottom { flex-direction: column; gap: 0.35rem; }
  }
  @media (prefers-reduced-motion: reduce) { .footer-links a, .footer-links a span { transition: none; } }
</style>
