---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-brand" href="/" aria-label="Philip Voultsos — home">Philip Voultsos<span aria-hidden="true">.</span></a>
      <p class="footer-note">Interested in ideas, institutions, and the people shaping them.</p>
      <nav class="footer-links" aria-label="Contact links">
        <a href="mailto:philip@voultsos.com">Email <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/voultsosp/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="/cv.pdf" target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {year} Philip Voultsos</p>
      <p>Athens, Greece <span class="footer-separator" aria-hidden="true">/</span> Personal academic profile</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    padding: 3.2rem 1.5rem 1.35rem;
    background: var(--ink);
    color: var(--paper);
  }

  .footer-inner { width: min(var(--site-width), 100%); margin: 0 auto; }
  .footer-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-bottom: 2.7rem;
  }
  .footer-brand {
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.8rem;
    letter-spacing: -0.045em;
    text-decoration: none;
    white-space: nowrap;
  }
  .footer-brand span { color: var(--accent-light); }
  .footer-note { max-width: 22rem; color: rgba(247, 244, 237, 0.66); font-size: 0.85rem; line-height: 1.6; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--paper);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .footer-links a span { color: var(--accent-light); }
  .footer-links a:hover { color: var(--accent-light); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(247, 244, 237, 0.18);
  }
  .footer-bottom p { color: rgba(247, 244, 237, 0.52); font-size: 0.7rem; }
  .footer-separator { padding: 0 0.45rem; color: var(--accent-light); }

  @media (max-width: 850px) {
    .footer-top { grid-template-columns: 1fr 1fr; align-items: start; }
    .footer-note { grid-column: 1; grid-row: 2; }
    .footer-links { grid-column: 2; grid-row: 1 / span 2; justify-content: flex-end; }
  }
  @media (max-width: 560px) {
    .site-footer { margin-top: 3.5rem; padding: 2.5rem 1.1rem 1.2rem; }
    .footer-top { grid-template-columns: 1fr; gap: 0.85rem; padding-bottom: 2rem; }
    .footer-note, .footer-links { grid-column: auto; grid-row: auto; justify-content: flex-start; }
    .footer-links { gap: 1.1rem; padding-top: 0.35rem; }
    .footer-bottom { flex-direction: column; gap: 0.45rem; }
  }
  @media (prefers-reduced-motion: reduce) { .footer-links a { transition: none; } }
</style>
