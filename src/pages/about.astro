---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, backgroundCopy, appointments, studies } from '../content/profile';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Background | ${profile.name}`}
      description={backgroundCopy.metaDescription}
    />
  </head>
  <body>
    <Header />

    <main id="main-content" class="site-width about-page">
      <header class="page-intro reveal">
        <p class="eyebrow">Background <span aria-hidden="true">/</span> 01</p>
        <h1 class="display-title">{backgroundCopy.titleLead} <em>{backgroundCopy.titleEmphasis}</em></h1>
        <p class="page-lede">{backgroundCopy.lede}</p>
      </header>

      <div class="about-layout">
        <article class="about-copy reveal">
          {profile.background.map((section) => (
            <section class="prose-section">
              <p class="section-index">{section.index} <span>/</span> {section.label}</p>
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
        </article>

        <aside class="profile-aside reveal" aria-label="Academic record">
          <section class="aside-section">
            <h2>Current subjects</h2>
            <ul class="aside-list">
              {studies.map((subject) => <li>{subject}</li>)}
            </ul>
          </section>

          <section class="aside-section">
            <h2>Selected responsibilities</h2>
            {appointments.map((item) => (
              <div class="aside-entry">
                <p>{item.title}</p>
                <span>{item.organisation}</span>
              </div>
            ))}
          </section>

          <section class="aside-section">
            <h2>Research question</h2>
            <p>{profile.research.question}</p>
          </section>
        </aside>
      </div>

      <section class="about-contact reveal">
        <p>{backgroundCopy.cvNote}</p>
        <div class="action-row">
          <a class="action-link action-link--primary magnetic" href="/cv.pdf" target="_blank" rel="noopener noreferrer">Academic CV <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`mailto:${profile.email}`}>Email Philip <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
