---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, homeCopy, academicFocus, appointments, studies } from '../content/profile';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="main-content" class="site-width home-page">
      <section class="opening reveal" aria-labelledby="home-title">
        <div class="opening-copy">
          <p class="eyebrow campus-tag">
            <span>{profile.school}</span>
            <span class="tag-separator" aria-hidden="true">/</span>
            <span>{profile.location.split(',')[0]}</span>
          </p>
          <h1 id="home-title" class="display-title">
            <span class="name-first">Philip</span>
            <span class="name-last">Voultsos</span>
          </h1>
          <ul class="discipline-tags" aria-label="Academic disciplines">
            <li class="discipline-tag discipline-tag--politics">Politics</li>
            <li class="discipline-tag discipline-tag--economics">Economics</li>
            <li class="discipline-tag discipline-tag--history">History</li>
          </ul>
          <p class="opening-summary">{homeCopy.introduction}</p>
          <div class="action-row">
            <a class="action-link action-link--primary" href="/cv">
              Academic CV
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M6 5h9v9" /></svg>
            </a>
            <a class="text-link magnetic" href="/about">Academic background <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <p class="opening-index" aria-hidden="true">Academic profile <span>2026</span></p>
      </section>

      <section class="focus-section reveal" aria-labelledby="focus-title">
        <div class="section-heading">
          <p class="section-index">01 <span>/</span> Academic interests</p>
          <h2 id="focus-title">{homeCopy.focusTitle}</h2>
        </div>
        <div class="focus-list">
          {academicFocus.map((item, index) => (
            <article class="focus-row">
              <span class="row-number">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="appointments-section reveal" aria-labelledby="appointments-title">
        <div class="section-heading section-heading--split">
          <div>
            <p class="section-index">02 <span>/</span> Selected work</p>
            <h2 id="appointments-title">{homeCopy.workTitle}</h2>
          </div>
          <a class="text-link" href="/cv">Full record in my CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="appointment-list">
          {appointments.map((item) => (
            <article class="appointment-row">
              <p class="appointment-date">{item.period}</p>
              <div class="appointment-role">
                <h3>{item.title}</h3>
                <p>{item.organisation}</p>
              </div>
              <p class="appointment-description">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="study-section reveal" aria-labelledby="study-title">
        <div class="study-intro">
          <p class="section-index">03 <span>/</span> Current studies</p>
          <h2 id="study-title">{homeCopy.studiesTitle}</h2>
          <p>{homeCopy.studiesSummary}</p>
        </div>
        <div class="study-detail">
          <p class="small-label">A-Level / IAL subjects</p>
          <ul class="study-list">
            {studies.map((subject) => <li>{subject}</li>)}
          </ul>
          <div class="research-note">
            <p class="small-label">Extended Project Qualification</p>
            <h3>{profile.research.question}</h3>
            <p>{profile.research.summary}</p>
          </div>
        </div>
      </section>

      <section class="contact-section reveal" aria-labelledby="contact-title">
        <div>
          <p class="section-index">Contact</p>
          <h2 id="contact-title">{homeCopy.contactTitle}</h2>
        </div>
        <div class="contact-actions">
          <a class="action-link action-link--primary" href="/cv">{homeCopy.cvAction} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={`mailto:${profile.email}`}>Email Philip <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
