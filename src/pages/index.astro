---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description="Personal portfolio, academic profile, and writings." title="Philip Voultsos"/>
  </head>
  <body>
    <!-- Hardware-Accelerated Ambient Glow -->
    <div id="global-glow"></div>

    <!-- Virtual Viewport for Inertial Momentum -->
    <div id="scroll-container">
      <Header/>
      <main>
        <!-- Bento Hero: Structural Integration of Portrait & Narrative -->
        <section class="bento-hero">
          <!-- Text & Mission Column -->
          <div class="bento-card bio-panel fade-in delay-1">
            <div class="status-indicator">
              <span class="status-pulse-ring"></span>
              <span class="status-dot"></span>
              <span>Sixth-Form Scholar &bull; Athens</span>
            </div>

            <h1 class="hero-title">Philip Voultsos</h1>
            
            <p class="hero-body">
              I’m an upper-secondary student focused on economics, political theory, and history, working toward PPE at university. Most of my time outside the classroom is divided between competitive debate, institutional governance, and essay writing.
            </p>

            <div class="btn-group">
              <a href="/about" class="btn-primary">
                <span>About Me</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/cv" class="btn-secondary">View Academic CV</a>
            </div>
          </div>

          <!-- Architecturally Integrated Portrait Column -->
          <div class="bento-card portrait-panel fade-in delay-2 tilt-element">
            <div class="portrait-layer">
              <img 
                src="/profile.png" 
                alt="Philip Voultsos" 
                class="portrait-canvas"
                onerror="this.closest('.portrait-panel').style.display='none'"
              />
            </div>
            <!-- Glass gradient bleed merging image directly into the container -->
            <div class="portrait-scrim"></div>
            <div class="portrait-caption">
              <span class="caption-label">Academic Profile</span>
              <span class="caption-sub">PPE &bull; Political Economy</span>
            </div>
          </div>
        </section>

        <!-- Directory Section with 3D Physics Cards -->
        <section class="directory-section fade-in delay-3">
          <div class="section-title-wrap">
            <h2>Site Directory</h2>
            <span class="section-hint">Explore Sections</span>
          </div>

          <div class="directory-grid">
            <!-- About Card -->
            <a href="/about" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">01</span>
                  <span class="card-pill">Background</span>
                </div>
                <h3>About</h3>
                <p>
                  Academic direction, core interests, and background outlining my focus in political philosophy and institutional economics.
                </p>
                <div class="card-action">
                  <span>Read statement</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <!-- CV Card -->
            <a href="/cv" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">02</span>
                  <span class="card-pill">Credentials</span>
                </div>
                <h3>Curriculum Vitae</h3>
                <p>
                  Coursework, examination marks, leadership appointments, debate honors, and organizational experience.
                </p>
                <div class="card-action">
                  <span>View credentials</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <!-- Writing Card -->
            <a href="/blog" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">03</span>
                  <span class="card-pill">Archive</span>
                </div>
                <h3>Writing & Research</h3>
                <p>
                  Supercurricular essays, competition submissions, and analytical commentary on macroeconomic frameworks and policy.
                </p>
                <div class="card-action">
                  <span>Browse archive</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
        </section>
      </main>
      <Footer/>
    </div>

    <!-- Physics & Tilt Engine -->
    <script>
      // 1. Inertial Scroll Dynamics
      let currentY = window.scrollY;
      let targetY = window.scrollY;
      const ease = 0.085;

      const scrollContainer = document.getElementById('scroll-container');
      const glow = document.getElementById('global-glow');

      function syncHeight() {
        if (scrollContainer) {
          document.body.style.height = `${scrollContainer.getBoundingClientRect().height}px`;
        }
      }
      window.addEventListener('resize', syncHeight);
      syncHeight();

      window.addEventListener('scroll', () => {
        targetY = window.scrollY;
      }, { passive: true });

      function physicsLoop() {
        currentY += (targetY - currentY) * ease;
        const roundedY = Math.round(currentY * 100) / 100;
        
        if (scrollContainer && window.innerWidth > 768) {
          scrollContainer.style.transform = `translate3d(0, -${roundedY}px, 0)`;
        } else if (scrollContainer) {
          scrollContainer.style.transform = 'none';
        }

        requestAnimationFrame(physicsLoop);
      }
      requestAnimationFrame(physicsLoop);

      // 2. Cursor Follower & 3D Interactive Spring Tilt
      const tiltElements = document.querySelectorAll('.tilt-element');
      const cards = document.querySelectorAll('.spotlight-card');

      window.addEventListener('mousemove', (e) => {
        if (glow) {
          glow.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
        }

        cards.forEach(card => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });

        tiltElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          const isHovered = (
            e.clientX >= rect.left &&
            e.clientX <= rect.right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom
          );

          if (isHovered) {
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const deltaX = (e.clientX - centerX) / (rect.width / 2);
            const deltaY = (e.clientY - centerY) / (rect.height / 2);

            const rotX = -deltaY * 6;
            const rotY = deltaX * 6;
            el.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateZ(6px)`;
          } else {
            el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
          }
        });
      });
    </script>
  </body>
</html>

<style>
  #scroll-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
    pointer-events: auto;
  }

  .tilt-element {
    transform-style: preserve-3d;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease;
    will-change: transform;
  }

  /* Bento Hero Layout */
  .bento-hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.75rem;
    padding: 2rem 0 3.5rem;
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: 3.5rem;
    align-items: stretch;
  }

  .bento-card {
    background: var(--glass-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.5);
  }

  .bio-panel {
    padding: 2.75rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .status-indicator {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-bright);
    margin-bottom: 1.5rem;
    width: fit-content;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    z-index: 2;
  }
  .status-pulse-ring {
    position: absolute;
    left: 15px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    animation: ringPulse 2.4s infinite cubic-bezier(0.24, 0, 0.38, 1);
  }
  @keyframes ringPulse {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(3.2); opacity: 0; }
    100% { transform: scale(3.2); opacity: 0; }
  }

  .hero-title {
    margin-bottom: 1.15rem;
  }
  .hero-body {
    font-size: 1.15rem;
    line-height: 1.65;
    margin-bottom: 2.25rem;
    color: var(--text-muted);
  }

  /* Structurally Merged Portrait Panel */
  .portrait-panel {
    position: relative;
    overflow: hidden;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    border-color: rgba(73, 125, 123, 0.3);
  }

  .portrait-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .portrait-canvas {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: contrast(1.04) brightness(0.92);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portrait-panel:hover .portrait-canvas {
    transform: scale(1.03);
  }

  /* Gradient scrim that blends the photo into the card floor */
  .portrait-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg, 
      rgba(9, 13, 14, 0.1) 0%, 
      rgba(9, 13, 14, 0.4) 40%, 
      rgba(9, 13, 14, 0.95) 100%
    );
  }

  .portrait-caption {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .caption-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-bright);
  }

  .caption-sub {
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 600;
  }

  /* Directory & Spotlight Cards */
  .directory-section {
    margin-bottom: 2rem;
  }
  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.75rem;
  }
  .section-hint {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .spotlight-card {
    position: relative;
    background: var(--glass-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 2.25rem 1.85rem;
    text-decoration: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .spotlight-glow {
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      500px circle at var(--mouse-x, -500px) var(--mouse-y, -500px),
      rgba(73, 125, 123, 0.22),
      transparent 75%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .spotlight-card:hover .spotlight-glow {
    opacity: 1;
  }

  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-step {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--primary-bright);
    letter-spacing: 0.08em;
  }
  .card-pill {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spotlight-card h3 {
    color: #ffffff;
    font-size: 1.45rem;
    margin-bottom: 0.65rem;
    transition: color 0.2s ease;
  }
  .spotlight-card:hover h3 {
    color: var(--primary-bright);
  }
  .spotlight-card p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-bright);
    margin-top: auto;
  }
  .arrow {
    transition: transform 0.25s var(--spring-bounce);
  }
  .spotlight-card:hover .arrow {
    transform: translateX(6px);
  }

  /* Responsive Fallback */
  @media (max-width: 820px) {
    #scroll-container {
      position: static;
      transform: none !important;
    }
    .bento-hero {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem 0 2.5rem;
    }
    .bio-panel {
      padding: 2rem 1.5rem;
    }
    .portrait-panel {
      min-height: 320px;
    }
    .directory-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
