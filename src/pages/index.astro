---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title="Philip Voultsos" 
      description="Personal portfolio, academic interests, and writing." 
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero: Scan-Friendly Z-Pattern -->
      <section class="hero-module">
        <div class="hero-left">
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span>Sixth-Form Scholar &bull; Athens</span>
          </div>

          <h1 class="hero-title">Philip Voultsos</h1>
          
          <p class="hero-body">
            I’m a student focused on economics, politics, and history, aiming toward PPE at university. Outside coursework, most of my focus goes into Model UN governance, parliamentary debate, and essay writing.
          </p>

          <div class="btn-group">
            <a href="/cv" class="btn-primary">
              <span>Academic CV & Roles</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/blog" class="btn-secondary">Read Essays & Papers</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="portrait-container">
            <img 
              src="/profile.png" 
              alt="Philip Voultsos" 
              class="portrait-img"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        </div>
      </section>

      <!-- Key Roles / Pillars Strip -->
      <section class="metrics-grid">
        <div class="glass-panel metric-box">
          <span class="metric-tag">Leadership</span>
          <h3 class="metric-title">BCIMUN 2027</h3>
          <p class="metric-desc">Secretary-General & Student Head of the Organising Committee.</p>
        </div>

        <div class="glass-panel metric-box">
          <span class="metric-tag">Academics</span>
          <h3 class="metric-title">PPE Preparation</h3>
          <p class="metric-desc">Macroeconomics, political institutions, and historical analysis.</p>
        </div>

        <div class="glass-panel metric-box">
          <span class="metric-tag">Publications</span>
          <h3 class="metric-title">Essays & Briefs</h3>
          <p class="metric-desc">Supercurricular competition papers and independent policy research.</p>
        </div>
      </section>

      <!-- Focused Content Split -->
      <section class="content-section">
        <h2>Focus & Engagement</h2>
        <div class="split-cards">
          <div class="glass-panel content-card">
            <span class="badge">Academic Inquiry</span>
            <h3>Economics & Political Theory</h3>
            <p>
              I read and write on macroeconomic policy, institutional governance, and how states manage market friction during political change.
            </p>
            <div class="tag-row">
              <span class="mini-tag">Fiscal Policy</span>
              <span class="mini-tag">Public Governance</span>
              <span class="mini-tag">Political Philosophy</span>
            </div>
          </div>

          <div class="glass-panel content-card">
            <span class="badge">Conference Administration</span>
            <h3>Model UN & Debate</h3>
            <p>
              Years of experience spanning delegate positions, committee chairs, crisis teams, and full conference logistics and administration.
            </p>
            <div class="tag-row">
              <span class="mini-tag">Rules of Procedure</span>
              <span class="mini-tag">Resolution Drafting</span>
              <span class="mini-tag">Committee Direction</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Featured Writing Showcase -->
      <section class="content-section">
        <div class="section-top">
          <h2>Selected Writing</h2>
          <a href="/blog" class="all-link">Browse archive &rarr;</a>
        </div>

        <div class="glass-panel writing-showcase">
          <div class="writing-meta">
            <span class="badge">Archive</span>
            <span class="writing-date">Policy & Theory</span>
          </div>
          <h3><a href="/blog" class="writing-link">Essays, Competition Entries & Policy Commentary</a></h3>
          <p>
            A curated archive of research papers, essay competition submissions, and long-form analysis covering international relations and economic policy.
          </p>
          <div class="writing-footer">
            <a href="/blog" class="btn-secondary" style="height: 40px; padding: 0 1.25rem;">Open Writing Archive</a>
          </div>
        </div>
      </section>

      <!-- Clean Contact Banner -->
      <section class="contact-banner glass-panel">
        <div>
          <h3>Inquiries & Collaboration</h3>
          <p>Get in touch for debate engagements, conference coordination, or academic discussion.</p>
        </div>
        <a href="mailto:philip@voultsos.com" class="btn-primary">philip@voultsos.com</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Hero Structure */
  .hero-module {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.5rem;
    padding: 2.5rem 0 3.5rem;
    margin-bottom: 2rem;
  }
  .hero-left {
    flex: 1;
  }
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--glass-surface);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
  }
  .hero-title {
    margin-bottom: 1rem;
  }
  .hero-body {
    font-size: 1.15rem;
    margin-bottom: 2rem;
    max-width: 600px;
  }

  /* Portrait */
  .hero-right {
    flex-shrink: 0;
  }
  .portrait-container {
    background: var(--glass-surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    padding: 8px;
    border-radius: 28px;
    box-shadow: var(--shadow-md);
  }
  .portrait-img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  /* Metrics 3-Card Band */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 4rem;
  }
  .metric-box {
    padding: 1.5rem;
  }
  .metric-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--secondary);
    display: block;
    margin-bottom: 0.5rem;
  }
  .metric-title {
    font-size: 1.25rem;
    margin-bottom: 0.35rem;
  }
  .metric-desc {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Section Spacing & Hierarchy */
  .content-section {
    margin-bottom: 4rem;
  }
  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .all-link {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .all-link:hover {
    color: var(--secondary);
  }

  /* Split Cards */
  .split-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .content-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .content-card h3 {
    margin-top: 0.85rem;
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .mini-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(0, 73, 83, 0.04);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--glass-border);
  }

  /* Writing Showcase */
  .writing-showcase {
    padding: 2.25rem;
  }
  .writing-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .writing-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--secondary);
  }
  .writing-link {
    text-decoration: none;
    color: var(--primary);
  }
  .writing-link:hover {
    color: var(--secondary);
  }
  .writing-footer {
    margin-top: 1.5rem;
  }

  /* Contact Glass Banner */
  .contact-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    background: linear-gradient(135deg, var(--glass-surface) 0%, rgba(242, 247, 247, 0.8) 100%);
    margin-top: 2rem;
  }
  .contact-banner h3 {
    margin-bottom: 0.25rem;
  }
  .contact-banner p {
    margin: 0;
  }

  /* Responsive Breakdown */
  @media (max-width: 768px) {
    .hero-module {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
      padding: 1.5rem 0 2.5rem;
    }
    .hero-body {
      margin-left: auto;
      margin-right: auto;
    }
    .portrait-img {
      width: 160px;
      height: 160px;
    }
    .contact-banner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .contact-banner .btn-primary {
      width: 100%;
    }
  }
</style>
