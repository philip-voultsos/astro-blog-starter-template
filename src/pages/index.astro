---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title="Philip Voultsos" 
      description="Personal portfolio, academic profile, and writings." 
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section: Fast scanning, clear focal points -->
      <section class="hero-module">
        <div class="hero-left">
          <div class="status-indicator">
            <span class="status-dot"></span>
            <span>Sixth-Form Scholar &bull; Athens</span>
          </div>

          <h1 class="hero-title">Philip Voultsos</h1>
          
          <p class="hero-body">
            I’m a student focused on economics, politics, and history, preparing for PPE at university. Outside the classroom, my time is centered on Model UN governance, competitive debate, and independent writing.
          </p>

          <div class="btn-group">
            <a href="/about" class="btn-primary">
              <span>About Me</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/cv" class="btn-secondary">View CV</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="portrait-container">
            <img 
              src="/profile.png" 
              alt="Philip Voultsos" 
              class="portrait-img"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        </div>
      </section>

      <!-- Navigation Directory: Outlining the Rest of the Website -->
      <section class="directory-section">
        <div class="section-title-wrap">
          <h2>Site Directory</h2>
          <span class="section-hint">Explore sections</span>
        </div>

        <div class="directory-grid">
          <!-- About Card -->
          <a href="/about" class="glass-panel directory-card">
            <div class="card-header">
              <span class="card-step">01</span>
              <span class="badge">Background</span>
            </div>
            <h3>About</h3>
            <p>
              Background, academic direction, and personal statement outlining my focus in political economy and philosophy.
            </p>
            <div class="card-action">
              <span>Read statement</span>
              <span class="arrow">&rarr;</span>
            </div>
          </a>

          <!-- CV Card -->
          <a href="/cv" class="glass-panel directory-card">
            <div class="card-header">
              <span class="card-step">02</span>
              <span class="badge">Experience</span>
            </div>
            <h3>Curriculum Vitae</h3>
            <p>
              Academic coursework, examination marks, leadership appointments, and conference secretariat records.
            </p>
            <div class="card-action">
              <span>View credentials</span>
              <span class="arrow">&rarr;</span>
            </div>
          </a>

          <!-- Writing Card -->
          <a href="/blog" class="glass-panel directory-card">
            <div class="card-header">
              <span class="card-step">03</span>
              <span class="badge">Archive</span>
            </div>
            <h3>Writing & Research</h3>
            <p>
              Independent essays, supercurricular competition submissions, and commentary on economic theory and international policy.
            </p>
            <div class="card-action">
              <span>Browse papers</span>
              <span class="arrow">&rarr;</span>
            </div>
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Hero Structure */
  .hero-module {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.5rem;
    padding: 2.5rem 0 3.5rem;
    border-bottom: 1px solid var(--glass-border);
    margin-bottom: 3.5rem;
  }
  .hero-left {
    flex: 1;
  }
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--glass-surface);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
  }
  .hero-title {
    margin-bottom: 1rem;
  }
  .hero-body {
    font-size: 1.15rem;
    margin-bottom: 2rem;
    max-width: 580px;
    color: var(--text-muted);
  }

  /* Portrait Image Frame */
  .hero-right {
    flex-shrink: 0;
  }
  .portrait-container {
    background: var(--glass-surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    padding: 8px;
    border-radius: 28px;
    box-shadow: var(--shadow-md);
    transition: transform 0.25s ease;
  }
  .portrait-container:hover {
    transform: translateY(-2px);
  }
  .portrait-img {
    width: 190px;
    height: 190px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  /* Directory Section */
  .directory-section {
    margin-bottom: 2rem;
  }
  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .section-hint {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Directory Grid Cards */
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .directory-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    padding: 2rem 1.75rem;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .directory-card:hover {
    transform: translateY(-4px);
    border-color: var(--glass-border-focus);
    box-shadow: var(--shadow-lg);
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .card-step {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--secondary);
    letter-spacing: 0.05em;
  }
  .directory-card h3 {
    color: var(--primary);
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }
  .directory-card:hover h3 {
    color: var(--secondary);
  }
  .directory-card p {
    font-size: 0.975rem;
    line-height: 1.55;
    margin-bottom: 1.75rem;
    color: var(--text-muted);
  }
  .card-action {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    margin-top: auto;
  }
  .arrow {
    transition: transform 0.2s ease;
  }
  .directory-card:hover .arrow {
    transform: translateX(4px);
  }

  /* Responsive Mobile Layout */
  @media (max-width: 768px) {
    .hero-module {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
      padding: 1.5rem 0 2.5rem;
    }
    .hero-body {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-left .btn-group {
      justify-content: center;
    }
    .portrait-img {
      width: 160px;
      height: 160px;
    }
    .directory-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
