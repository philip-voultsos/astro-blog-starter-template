---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead 
      title="Philip Voultsos — Academic Portfolio & Research" 
      description="Personal portfolio, academic profile, and writings on political economy, institutional governance, and diplomacy." 
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section with Headshot and Live Indicator -->
      <section class="hero-container">
        <div class="hero-left">
          <div class="status-indicator">
            <span class="pulsing-dot"></span>
            <span class="status-text">Sixth-Form Scholar &bull; Prospective PPE</span>
          </div>

          <h1 class="hero-title">Philip Voultsos</h1>
          
          <p class="hero-tagline">
            Student, researcher, and debater focused on macroeconomic policy, institutional political theory, and historical statecraft.
          </p>

          <div class="hero-actions">
            <a href="/cv" class="btn">
              <span>View Academic CV</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/blog" class="btn btn-secondary">Selected Writings</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="portrait-frame">
            <img 
              src="/profile.png" 
              alt="Philip Voultsos" 
              class="portrait-img"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        </div>
      </section>

      <!-- Key Academic & Leadership Highlight Cards -->
      <section class="highlight-band">
        <div class="band-card">
          <span class="band-num">BCIMUN</span>
          <span class="band-label">Secretariat & Governance</span>
        </div>
        <div class="band-card">
          <span class="band-num">PPE</span>
          <span class="band-label">Academic Specialization</span>
        </div>
        <div class="band-card">
          <span class="band-num">ESSAYS</span>
          <span class="band-label">Policy & Theory Archive</span>
        </div>
      </section>

      <!-- Areas of Inquiry Grid -->
      <section class="section-block">
        <h2>Areas of Inquiry</h2>
        <div class="inquiry-grid">
          <div class="card inquiry-card">
            <div class="inquiry-badge">Theory & Policy</div>
            <h3>Political Economy & State Institutions</h3>
            <p>
              Investigating the interplay between constitutional frameworks, market dynamics, and fiscal policies that underpin democratic resilience.
            </p>
            <div class="topic-tags">
              <span class="badge">Macroeconomics</span>
              <span class="badge">Institutional Design</span>
              <span class="badge">Trade Dynamics</span>
            </div>
          </div>

          <div class="card inquiry-card">
            <div class="inquiry-badge">Diplomacy & Practice</div>
            <h3>Diplomatic Simulation & Debate</h3>
            <p>
              Directing parliamentary procedure, shaping conference crises, and facilitating high-level debate through substantive resolution drafting.
            </p>
            <div class="topic-tags">
              <span class="badge">Secretariat Administration</span>
              <span class="badge">Crisis Management</span>
              <span class="badge">Rules of Procedure</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Featured Writing Showcase -->
      <section class="section-block">
        <div class="block-header">
          <h2>Selected Writings</h2>
          <a href="/blog" class="inline-link">Browse Full Archive &rarr;</a>
        </div>

        <div class="card writing-card">
          <div class="writing-top">
            <span class="badge">Research & Essay Archive</span>
            <span class="writing-date">Recent Submissions</span>
          </div>
          <h3 class="writing-title">
            <a href="/blog">Independent Research Papers & Policy Commentary</a>
          </h3>
          <p>
            Supercurricular essays, competition submissions, and long-form analysis covering international order, game theory, and political economy.
          </p>
          <a href="/blog" class="writing-cta">Read articles &rarr;</a>
        </div>
      </section>

      <!-- Academic Inquiries Banner -->
      <section class="inquiry-banner">
        <div class="banner-content">
          <h3>Academic Inquiries & Dialogue</h3>
          <p>Always open to debate engagements, research discussions, and conference coordination.</p>
        </div>
        <a href="mailto:philip@voultsos.com" class="btn">Get in Touch</a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Hero Container */
  .hero-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3.5rem;
    padding: 2rem 0 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 3.5rem;
  }
  .hero-left {
    flex: 1;
  }
  .hero-title {
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .hero-tagline {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 620px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* Status Pill with Pulsing Dot */
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }
  .status-text {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .pulsing-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
    animation: pulse 2s infinite cubic-bezier(0.66, 0, 0, 1);
  }
  @keyframes pulse {
    to {
      box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
    }
  }

  /* Headshot with Multi-Layered Border */
  .hero-right {
    flex-shrink: 0;
  }
  .portrait-frame {
    position: relative;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 28px;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .portrait-frame:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .portrait-img {
    width: 195px;
    height: 195px;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  /* Highlight Metrics Band */
  .highlight-band {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 4rem;
  }
  .band-card {
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 1.25rem 1rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .band-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .band-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .band-label {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-subtle);
  }

  /* Inquiry Block */
  .section-block {
    margin-bottom: 4rem;
  }
  .inquiry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .inquiry-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .inquiry-badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 0.75rem;
  }
  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  /* Writing Block */
  .block-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .inline-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary);
    text-decoration: none;
  }
  .inline-link:hover {
    color: var(--secondary);
  }
  .writing-card {
    padding: 2rem;
  }
  .writing-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .writing-date {
    font-size: 0.85rem;
    color: var(--text-subtle);
  }
  .writing-title a {
    text-decoration: none;
    color: var(--primary);
    transition: color 0.2s ease;
  }
  .writing-title a:hover {
    color: var(--secondary);
  }
  .writing-cta {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary);
    text-decoration: none;
  }
  .writing-cta:hover {
    text-decoration: underline;
  }

  /* Inquiry Callout Banner */
  .inquiry-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-muted) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: 18px;
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
  }
  .banner-content h3 {
    color: var(--primary);
    margin-bottom: 0.35rem;
  }
  .banner-content p {
    color: var(--text-muted);
    margin: 0;
  }

  /* Mobile Layout */
  @media (max-width: 768px) {
    .hero-container {
      flex-direction: column-reverse;
      text-align: center;
      gap: 2rem;
      padding: 1.5rem 0 2.5rem;
    }
    .hero-tagline {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .highlight-band {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .inquiry-banner {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem;
    }
  }
</style>
