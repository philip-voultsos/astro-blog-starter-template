---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description="Personal portfolio, academic profile, and writings." title="Philip Voultsos"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div id="global-glow"></div>

    <div id="scroll-container">
      <Header/>
      <main>
        
        <!-- Adjusted data-tilt to 1.5 to ground the large hero card -->
        <section class="unified-hero bento-card fade-in delay-1 tilt-element" data-tilt="1.5">
          
          <div class="hero-portrait-layer">
            <img 
              src="/profile.png" 
              alt="Philip Voultsos" 
              class="portrait-canvas"
              onerror="this.style.display='none'"
            />
          </div>

          <div class="hero-content-layer">
            <div class="status-indicator">
              <span class="status-pulse-ring"></span>
              <span class="status-dot"></span>
              <span>Sixth-Form Scholar &bull; <span id="athens-time">Athens</span></span>
            </div>

            <h1 class="hero-title">Philip Voultsos</h1>
            
            <p class="hero-body">
              I’m an upper-secondary student focused on economics, political theory, and history, working toward PPE at university. Most of my time outside the classroom is divided between competitive debate, institutional governance, and essay writing.
            </p>

            <div class="btn-group">
              <a href="/about" class="btn-primary">
                <span>About Me</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/cv" class="btn-secondary">View Academic CV</a>
            </div>
          </div>
        </section>

        <section class="directory-section fade-in delay-2">
          <div class="section-title-wrap">
            <h2>Site Directory</h2>
            <span class="section-hint">Explore Sections</span>
          </div>

          <div class="directory-grid">
            <a href="/about" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">01</span>
                  <span class="card-pill">Background</span>
                </div>
                <h3>About</h3>
                <p>
                  Academic direction, core interests, and background outlining my focus in political philosophy and institutional economics.
                </p>
                <div class="card-action">
                  <span>Read statement</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <a href="/cv" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">02</span>
                  <span class="card-pill">Credentials</span>
                </div>
                <h3>Curriculum Vitae</h3>
                <p>
                  Coursework, examination marks, leadership appointments, debate honors, and organizational experience.
                </p>
                <div class="card-action">
                  <span>View credentials</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <a href="/blog" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">03</span>
                  <span class="card-pill">Archive</span>
                </div>
                <h3>Writing & Research</h3>
                <p>
                  Supercurricular essays, competition submissions, and analytical commentary on macroeconomic frameworks and policy.
                </p>
                <div class="card-action">
                  <span>Browse archive</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
        </section>
      </main>
      <Footer/>
    </div>

    <!-- Physics, Animation & Temporal Engine -->
    <script>
      // 1. Live Temporal Status
      function updateTime() {
        const timeTarget = document.getElementById('athens-time');
        if (!timeTarget) return;
        
        const options = { 
          timeZone: 'Europe/Athens', 
          hour: 'numeric', 
          minute: '2-digit',
          hour12: true 
        };
        const timeString = new Intl.DateTimeFormat('en-US', options).format(new Date());
        timeTarget.innerHTML = `Athens &mdash; ${timeString}`;
      }
      setInterval(updateTime, 1000);
      updateTime(); 

      // 2. Intersection Observer Fade-Ins
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };
      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);
      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

      // 3. Inertial Scroll Dynamics
      let currentY = window.scrollY;
      let targetY = window.scrollY;
      const ease = 0.085;

      const scrollContainer = document.getElementById('scroll-container');
      const glow = document.getElementById('global-glow');

      function syncHeight() {
        if (scrollContainer) {
          document.body.style.height = `${scrollContainer.getBoundingClientRect().height}px`;
        }
      }
      window.addEventListener('resize', syncHeight);
      syncHeight();

      window.addEventListener('scroll', () => {
        targetY = window.scrollY;
      }, { passive: true });

      function physicsLoop() {
        currentY += (targetY - currentY) * ease;
        const roundedY = Math.round(currentY * 100) / 100;
        
        if (scrollContainer && window.innerWidth > 768) {
          scrollContainer.style.transform = `translate3d(0, -${roundedY}px, 0)`;
        } else if (scrollContainer) {
          scrollContainer.style.transform = 'none';
        }

        requestAnimationFrame(physicsLoop);
      }
      requestAnimationFrame(physicsLoop);

      // 4. Cursor Follower & Variable Tilt Physics
      const tiltElements = document.querySelectorAll('.tilt-element');
      const cards = document.querySelectorAll('.spotlight-card');

      window.addEventListener('mousemove', (e) => {
        if (glow) {
          glow.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
        }

        cards.forEach(card => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });

        tiltElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          const isHovered = (
            e.clientX >= rect.left &&
            e.clientX <= rect.right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom
          );

          if (isHovered) {
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const deltaX = (e.clientX - centerX) / (rect.width / 2);
            const deltaY = (e.clientY - centerY) / (rect.height / 2);

            // Fetch custom tilt multiplier, fallback to 6 for standard cards
            const intensity = el.dataset.tilt ? parseFloat(el.dataset.tilt) : 6;

            const rotX = -deltaY * intensity;
            const rotY = deltaX * intensity;
            el.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateZ(6px)`;
          } else {
            el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
          }
        });
      });
    </script>
  </body>
</html>

<style>
  #scroll-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    will-change: transform;
    pointer-events: auto;
  }

  .tilt-element {
    transform-style: preserve-3d;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease;
    will-change: transform;
  }

  .bento-card {
    background: var(--glass-surface);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.5);
  }

  .unified-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 480px;
    padding: 4rem 3.5rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }

  .hero-content-layer {
    position: relative;
    z-index: 2;
    max-width: 60%;
  }

  .hero-portrait-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 55%;
    z-index: 1;
    pointer-events: none;
  }

  .portrait-canvas {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    filter: contrast(1.04) brightness(0.92);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 35%, black 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 35%, black 100%);
  }

  .status-indicator {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary-bright);
    margin-bottom: 1.5rem;
    width: fit-content;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    z-index: 2;
  }
  .status-pulse-ring {
    position: absolute;
    left: 15px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    animation: ringPulse 2.4s infinite cubic-bezier(0.24, 0, 0.38, 1);
  }
  @keyframes ringPulse {
    0% { transform: scale(1); opacity: 0.8; }
    70% { transform: scale(3.2); opacity: 0; }
    100% { transform: scale(3.2); opacity: 0; }
  }

  .hero-title { margin-bottom: 1.15rem; }
  .hero-body {
    font-size: 1.15rem;
    line-height: 1.65;
    margin-bottom: 2.25rem;
    color: var(--text-muted);
  }

  .directory-section { margin-bottom: 2rem; }
  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.75rem;
  }
  .section-hint {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-bright);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.5rem;
  }

  .spotlight-card {
    position: relative;
    padding: 2.25rem 1.85rem;
    text-decoration: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .spotlight-glow {
    pointer-events: none;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(
      500px circle at var(--mouse-x, -500px) var(--mouse-y, -500px),
      rgba(73, 125, 123, 0.22),
      transparent 75%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }
  .spotlight-card:hover .spotlight-glow { opacity: 1; }

  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  
  .card-step {
    font-family: 'Cinzel', Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--primary-bright);
    letter-spacing: 0.08em;
  }
  
  .card-pill {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .spotlight-card h3 {
    color: var(--text-heading);
    font-size: 1.45rem;
    margin-bottom: 0.65rem;
    transition: color 0.2s ease;
  }
  .spotlight-card:hover h3 { color: var(--primary-bright); }
  
  .spotlight-card p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  .card-action {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-bright);
    margin-top: auto;
  }
  .arrow { transition: transform 0.25s var(--spring-bounce); }
  .spotlight-card:hover .arrow { transform: translateX(6px); }

  @media (max-width: 820px) {
    #scroll-container {
      position: static;
      transform: none !important;
    }
    
    .unified-hero {
      flex-direction: column;
      padding: 2.5rem 1.5rem;
      min-height: auto;
    }
    
    .hero-content-layer {
      max-width: 100%;
      margin-top: 240px;
    }
    
    .hero-portrait-layer {
      width: 100%;
      height: 320px;
      bottom: auto;
    }
    
    .portrait-canvas {
      object-position: center 10%;
      -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
    }

    .directory-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
