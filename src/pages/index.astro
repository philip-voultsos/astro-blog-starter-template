    <!-- Full-screen Dynamic Ambient Spotlight -->
    <div id="global-glow"></div>

    <!-- Momentum Physics Viewport -->
    <div id="scroll-container">
      <Header />
      <main>
        <!-- Interlocking Hero Bento Module -->
        <section class="hero-bento tilt-element fade-in delay-1">
          <div class="bento-inner">
            <!-- Left: Core Bio & Navigation -->
            <div class="bento-bio">
              <div class="status-indicator">
                <span class="status-pulse-ring"></span>
                <span class="status-dot"></span>
                <span>Sixth-Form Scholar &bull; Athens</span>
              </div>

              <h1 class="hero-title">Philip Voultsos</h1>
              
              <p class="hero-body">
                I’m a student focused on economics, politics, and history, preparing for PPE at university. Outside coursework, my focus is divided between competitive debate, institutional governance, and independent writing.
              </p>

              <div class="btn-group">
                <a href="/about" class="btn-primary">
                  <span>About Me</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a href="/cv" class="btn-secondary">View Academic CV</a>
              </div>
            </div>

            <!-- Right: Structurally Integrated Portrait Wing -->
            <div class="bento-portrait-wing">
              <div class="portrait-scaffold">
                <img 
                  src="/profile.png" 
                  alt="Philip Voultsos" 
                  class="scaffold-img"
                  onerror="this.parentElement.parentElement.style.display='none'"
                />
                <!-- Subtle Gradient Vignette to Fuse Image to Background -->
                <div class="scaffold-overlay"></div>
                <div class="scaffold-caption">
                  <span class="scaffold-name">Philip Voultsos</span>
                  <span class="scaffold-tag">PPE & Political Economy</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Site Directory Grid -->
        <section class="directory-section fade-in delay-2">
          <div class="section-title-wrap">
            <h2>Site Directory</h2>
            <span class="section-hint">Explore Sections</span>
          </div>

          <div class="directory-grid">
            <!-- 01: About -->
            <a href="/about" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">01</span>
                  <span class="card-pill">Background</span>
                </div>
                <h3>About</h3>
                <p>
                  Academic direction, background, and personal statement focusing on political economy, institutional history, and philosophy.
                </p>
                <div class="card-action">
                  <span>Read statement</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <!-- 02: CV -->
            <a href="/cv" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">02</span>
                  <span class="card-pill">Credentials</span>
                </div>
                <h3>Curriculum Vitae</h3>
                <p>
                  Academic records, qualifications, debate leadership appointments, and extracurricular achievements.
                </p>
                <div class="card-action">
                  <span>View credentials</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>

            <!-- 03: Writing -->
            <a href="/blog" class="spotlight-card tilt-element">
              <div class="spotlight-glow"></div>
              <div class="card-content">
                <div class="card-header">
                  <span class="card-step">03</span>
                  <span class="card-pill">Archive</span>
                </div>
                <h3>Writing & Research</h3>
                <p>
                  Supercurricular competition essays, policy commentary, and analytical papers on macroeconomic frameworks.
                </p>
                <div class="card-action">
                  <span>Browse archive</span>
                  <span class="arrow">&rarr;</span>
                </div>
              </div>
            </a>
          </div>
        </section>
      </main>
      <Footer />
    </div>

