---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const essays = await Astro.glob('../../content/essays/*.md');
  return essays.map(essay => ({
    params: { slug: essay.file.split('/').pop().replace('.md', '') },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = essay;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description={essay.frontmatter.description} title={`${essay.frontmatter.title} | Philip Voultsos`}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div id="global-glow"></div>

    <div id="scroll-container">
      <Header/>
      <main class="page-main">
        
        <div class="back-wrap fade-in delay-1">
          <a href="/blog" class="back-link">
            <span>&larr;</span> Return to Archive
          </a>
        </div>

        <article class="bento-card essay-card fade-in delay-2 tilt-element" data-tilt="1">
          <div class="essay-header-block">
            <span class="essay-category-pill">{essay.frontmatter.category || 'Essay'}</span>
            <span class="essay-date">{new Date(essay.frontmatter.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>

          <h1 class="essay-title">{essay.frontmatter.title}</h1>
          
          <div class="essay-divider"></div>
          
          <div class="prose-content">
            <Content />
          </div>
        </article>

      </main>
      <Footer/>
    </div>

    <!-- Unified Physics & Tilt Engine -->
    <script>
      const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 };
      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);
      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

      let currentY = window.scrollY;
      let targetY = window.scrollY;
      const ease = 0.085;
      const scrollContainer = document.getElementById('scroll-container');
      const glow = document.getElementById('global-glow');

      function syncHeight() {
        if (scrollContainer) {
          document.body.style.height = `${scrollContainer.getBoundingClientRect().height}px`;
        }
      }
      window.addEventListener('resize', syncHeight);
      syncHeight();

      window.addEventListener('scroll', () => { targetY = window.scrollY; }, { passive: true });

      function physicsLoop() {
        currentY += (targetY - currentY) * ease;
        const roundedY = Math.round(currentY * 100) / 100;
        if (scrollContainer && window.innerWidth > 768) {
          scrollContainer.style.transform = `translate3d(0, -${roundedY}px, 0)`;
        } else if (scrollContainer) {
          scrollContainer.style.transform = 'none';
        }
        requestAnimationFrame(physicsLoop);
      }
      requestAnimationFrame(physicsLoop);

      const tiltElements = document.querySelectorAll('.tilt-element');
      window.addEventListener('mousemove', (e) => {
        if (glow) {
          glow.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
        }
        tiltElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          const isHovered = (e.clientX >= rect.left && e.clientX <= rect.right && e.clientY >= rect.top && e.clientY <= rect.bottom);
          if (isHovered) {
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const deltaX = (e.clientX - centerX) / (rect.width / 2);
            const deltaY = (e.clientY - centerY) / (rect.height / 2);
            const intensity = el.dataset.tilt ? parseFloat(el.dataset.tilt) : 6;
            el.style.transform = `perspective(1000px) rotateX(${-deltaY * intensity}deg) rotateY(${deltaX * intensity}deg) translateZ(4px)`;
          } else {
            el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
          }
        });
      });
    </script>
  </body>
</html>

<style>
  #scroll-container { position: fixed; top: 0; left: 0; width: 100%; will-change: transform; pointer-events: auto; }
  .page-main { padding-top: 4rem; max-width: 820px; }
  
  .back-wrap { margin-bottom: 2rem; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary-bright);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: transform 0.25s var(--spring-bounce);
  }
  .back-link:hover { transform: translateX(-6px); color: var(--text-heading); }

  .tilt-element { transform-style: preserve-3d; transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease; will-change: transform; }
  .bento-card { background: var(--glass-surface); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 28px; box-shadow: 0 12px 36px -8px rgba(0, 0, 0, 0.5); }
  
  .essay-card { padding: 4rem; }
  
  .essay-header-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .essay-category-pill {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .essay-date {
    font-family: 'Cinzel', serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-bright);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .essay-title {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    color: var(--text-heading);
    margin-bottom: 1.5rem;
  }

  .essay-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 3rem;
  }

  /* Prose typography styling for written essays */
  .prose-content :global(h2) {
    font-size: 1.8rem;
    color: var(--text-heading);
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .prose-content :global(h3) {
    font-size: 1.35rem;
    color: var(--text-heading);
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .prose-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.85;
    color: var(--text-main);
    margin-bottom: 1.75rem;
  }

  .prose-content :global(blockquote) {
    border-left: 3px solid var(--primary);
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    color: var(--primary-bright);
    font-style: italic;
    font-size: 1.2rem;
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
    color: var(--text-main);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 820px) {
    #scroll-container { position: static; transform: none !important; }
    .essay-card { padding: 2.5rem 1.5rem; }
  }
</style>
